<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

	<Script file="Keyboard.lua"/>

    <Button name="EmojiKeyboardPackListItemTemplate" mixin="EmojiKeyboardPackListItemMixin" virtual="true">
        <Scripts>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <Button name="EmojiKeyboardGroupItemTemplate" mixin="EmojiKeyboardGroupItemMixin" virtual="true">
        <Layers>
            <Layer>
				<FontString parentKey="Label" inherits="GameFontWhite" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </FontString>
			</Layer>
        </Layers>
    </Button>

    <Button name="EmojiKeyboardEmojiItemTemplate" mixin="EmojiKeyboardEmojiItemMixin" virtual="true">
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Button>

    <Button name="EmojiKeyboardEmojiItemButtonTemplate" mixin="EmojiKeyboardEmojiItemButtonMixin" virtual="true">
		<HighlightTexture alphaMode="ADD" file="Interface\Buttons\ButtonHilight-Square"/>
        <Scripts>
            <OnEvent method="OnEvent"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <Button name="EmojiKeyboardGroupListItemTemplate" mixin="EmojiKeyboardGroupListItemMixin" virtual="true">
        <Scripts>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>
</Ui>